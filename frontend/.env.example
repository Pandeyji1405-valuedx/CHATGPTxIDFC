# IDFC RBI Compliance Chatbot — Frontend
# ============================================================
#
# Copy this file to .env and set the correct values.
# NEVER commit .env to version control.
# ============================================================

# Backend API base URL
# In development, Vite proxies /api → this URL
# Leave empty to use Vite proxy (recommended for local dev)
VITE_API_BASE_URL=http://localhost:8000

# Application name (used in page titles if needed)
VITE_APP_NAME="IDFC RBI Compliance Chatbot"

# Environment label
VITE_APP_ENV=development
