# ============================================================
# IDFC RBI Compliance & Advisory Assistant — Backend Environment Variables
#
# Copy this file to .env and fill in real values.
# NEVER commit .env to version control.
# ============================================================

# --- Application ---
APP_NAME="IDFC RBI Compliance Chatbot"
APP_ENV=development
APP_VERSION=0.1.0
DEBUG=true

# --- Server ---
HOST=0.0.0.0
PORT=8000

# --- PostgreSQL ---
# Format: postgresql+asyncpg://user:password@host:port/dbname
DATABASE_URL=postgresql+asyncpg://postgres:your_password@localhost:5432/idfc_chatbot_db

# Sync URL used by Alembic (psycopg2 driver)
DATABASE_SYNC_URL=postgresql+psycopg2://postgres:your_password@localhost:5432/idfc_chatbot_db

# --- Security (JWT) ---
JWT_SECRET_KEY=replace_with_a_strong_random_secret_key_minimum_32_characters
JWT_ALGORITHM=HS256
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=30

# --- CORS ---
# Comma-separated list of allowed frontend origins
FRONTEND_URL=http://localhost:5173

# --- Storage & Vector DB ---
STORAGE_DIR=storage/documents
CHROMADB_DIR=storage/chromadb
CHROMA_COLLECTION_NAME=rbi_documents
EMBEDDING_MODEL_NAME=nomic-ai/nomic-embed-text-v1.5
EMBEDDING_DIMENSION=768

# --- LLM Gateway & RAG Pipeline ---
GEMINI_API_KEY=your_google_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash
RERANKER_MODEL_NAME=BAAI/bge-reranker-v2-m3
RERANKER_ENABLED=true

# --- Memory & Caching ---
REDIS_URL=redis://localhost:6379/0
REDIS_ENABLED=true
CACHE_ENABLED=true
SEMANTIC_CACHE_SIMILARITY_THRESHOLD=0.92

# --- Security & Audit ---
RATE_LIMIT_ENABLED=true
AUDIT_LOG_ENABLED=true
PII_REDACTION_ENABLED=true
